usecaseDiagram
    actor "User" as U

    package "Personal Finance Tracker System" {
        usecase "Add Transaction" as UC1
        usecase "Edit Transaction" as UC2
        usecase "Delete Transaction" as UC3
        usecase "Search Transactions" as UC4
        usecase "View Dashboard" as UC5
        
        usecase "Set Monthly Budget" as UC6
        usecase "Track Expenses" as UC7
        usecase "Categorize Transactions" as UC8
        usecase "Generate Reports" as UC9
        usecase "Manage Settings" as UC10
        usecase "Budget Alert" as UC11
    }

    U --> UC1
    U --> UC2
    U --> UC3
    U --> UC4
    U --> UC5
    U --> UC6
    U --> UC7
    U --> UC10

    UC1 ..> UC8 : <<include>>
    UC5 ..> UC9 : <<include>>
    UC7 ..> UC11 : <<extend>>
